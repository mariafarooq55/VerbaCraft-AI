# ---------------------------------------------------------------------------
# VerbaCraft AI — environment settings
# Copy this file to .env and fill in what you need.
# MongoDB Atlas is the primary database; without it, articles and accounts
# are saved to local files in .data/ so the app still works.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (required for multi-user / cloud deployment)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=verbacraft_ai

# Optional, recommended for a deployed website. Use a long random value.
# Local development automatically creates a private key in .data/ if omitted.
AUTH_SECRET=

# Optional: add live AI writing. Set ONE of these keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
